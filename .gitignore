# 依赖与构建产物
player/node_modules/
player/dist/
player/accounts/dist/
.tmp/

# 演示素材由 player/make-demo.js 生成，不入库（~3.6 MB）
player/demo/demo.wav
player/demo/demo.png
player/demo/demo.lrc
player/demo/shot-*.png

# 探针运行时输出
player/demo/*.log

# 系统与编辑器
Thumbs.db
desktop.ini
.DS_Store
*.tmp

# 发布产物（源码包/安装包）不入库
*.zip
*.exe

# release/ 里的安装包与内置轻量原生音频引擎要入库（覆盖上面的 *.exe 忽略）
!release/*.exe
!player/bin/nckik-audio.exe
player/native-audio/*.obj
