# ============================================================================
# Nckik′s music · 环境变量参考（模板）
# ----------------------------------------------------------------------------
# 注意：本项目**不读取 .env 文件**，也不依赖 dotenv。下面这些变量都是
# 「想临时改行为时，在启动前于终端里 export / set 一次」用的，属于开发者开关，
# 正常使用完全不需要设置任何一个。
#
# 用法示例（Windows cmd）：
#   set NE_BASE=http://127.0.0.1:3000 && npm start
# 用法示例（bash / Git Bash）：
#   NE_BASE=http://127.0.0.1:3000 npm start
#
# 本文件可以复制成自己的启动脚本使用，但**不要**直接改名为 .env 期待被加载。
# ============================================================================

# --- 联网（音源适配） ---------------------------------------------------------
# 把网易云接口指向别处：本地 mock 服务、抓包代理、或者被封时的镜像。
# 不设置时默认 https://music.163.com
# NE_BASE=http://127.0.0.1:3000

# --- 测试 / 调试 -------------------------------------------------------------
# 跳过「旧数据目录迁移」（改名后的一次性搬运）。自动化测试必须设为 1，
# 否则空配置会被本机真实曲库污染。
# NCKIK_SKIP_MIGRATION=1

# 截图模式：设置后应用加载完自动截图并退出（CI 出图用，正常使用不要设）
# SHOT=out.png
# SHOT_OPEN=lib            # 启动即打开哪个抽屉：lib / set
# SHOT_FS=1                # 截图前先进入全屏
# SHOT_T=30                # 打开页面后跳到指定秒数（歌词演示）
# SHOT_P=60%               # 直接把当前歌词行的擦除进度设成指定值
# SHOT_RECT=0,0,1200,800   # 只截指定矩形区域
# SHOT_DPR=1               # 强制 devicePixelRatio（出 2x 图用）

# --- 运行环境注意 -------------------------------------------------------------
# 如果你的终端环境里预设了 ELECTRON_RUN_AS_NODE=1，Electron 会退化成纯 Node，
# 窗口不会出现（报错形如 "bad option: --enable-webgl"）。
# 启动前清掉它：Windows cmd 用  set "ELECTRON_RUN_AS_NODE="
#              bash 用          env -u ELECTRON_RUN_AS_NODE npm start
